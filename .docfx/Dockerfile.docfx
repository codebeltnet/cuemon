# For the local multi-framework image, run pwsh .docfx/BuildDocfxImage.ps1.
# To build this Dockerfile directly from the repository root:
#        pwsh .docfx/BuildRunActions.ps1
#        pwsh .docfx/TestRunActions.ps1
#        docfx metadata .docfx/docfx.json
#        docker build -f .docfx/Dockerfile.docfx .docfx
# Direct builds fail immediately if generated run-actions/ scripts are missing or incomplete.

ARG NGINX_VERSION=1.31-alpine

FROM --platform=$BUILDPLATFORM dhi.io/nginx:${NGINX_VERSION} AS base
RUN rm -rf /usr/share/nginx/html/*

FROM --platform=$BUILDPLATFORM codebeltnet/docfx:2 AS build

ADD [".", "docfx"]

RUN set -eu; \
    cd docfx; \
    sh ./verify-docfx-site.sh --context .; \
    docfx build; \
    sh ./verify-docfx-site.sh --site wwwroot --source . --manifest run-actions.manifest.json

FROM dhi.io/nginx:${NGINX_VERSION} AS final
WORKDIR /usr/share/nginx/html
COPY --from=build /build/docfx/wwwroot /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
